{
  "name": "carvana-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript Page Object Model automation framework for carvana.com",
  "author": "Reaz Uddin",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf reports test-results",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "20": "^3.1.9",
    "version": "^0.1.2"
  }
}
